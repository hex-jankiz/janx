<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#14532d">
<title>جنكيز — رفع دقة الفيديو</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
tailwind.config={theme:{extend:{fontFamily:{cairo:['Cairo','sans-serif']},colors:{brand:{50:'#f0fdf4',100:'#dcfce7',500:'#22c55e',600:'#16a34a',700:'#15803d',800:'#166534',900:'#14532d'}}}}};
</script>
<style>
body{font-family:Cairo,sans-serif;background:#f3f4f6;color:#1f2937}
.upload-zone{border:2px dashed #cbd5e1;transition:.2s}.upload-zone.dragover{border-color:#16a34a;background:#f0fdf4}
.card-shadow{box-shadow:0 4px 14px #0000000d}
input[type=radio]:checked+div{border-color:#16a34a;background:#f0fdf4}
button:disabled{opacity:.5;cursor:not-allowed}
</style>
</head>
<body class="min-h-screen flex flex-col">
<header class="bg-brand-900 text-white shadow-lg sticky top-0 z-20">
 <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
  <div class="flex items-center gap-3"><div class="rounded-full bg-brand-500 text-brand-900 w-10 h-10 flex items-center justify-center text-2xl font-bold">▶</div><div><h1 class="text-2xl font-extrabold">جنكيز</h1><p class="text-sm text-green-100">رفع دقة الفيديو محلياً</p></div></div>
  <span class="hidden sm:block text-xs text-green-100">تتم المعالجة على جهازك</span>
 </div>
</header>
<main class="max-w-5xl mx-auto px-4 py-8 w-full flex-grow">
 <section class="text-center mb-8"><h2 class="text-3xl md:text-4xl font-extrabold mb-3">ارفع جودة فيديوهاتك بسهولة</h2><p class="text-gray-600 max-w-2xl mx-auto">غيّر دقة الفيديو، واضبط أبعاده، وطبّق فلاتر تقليدية باستخدام FFmpeg داخل المتصفح. لا يتم رفع الفيديو إلى خادم.</p></section>
 <div id="error-box" class="hidden mb-5 bg-red-50 border-r-4 border-red-500 text-red-800 p-4 rounded-xl card-shadow" role="alert"><div class="font-bold mb-1">تعذّرت العملية</div><div id="error-text" class="text-sm break-words"></div><button id="dismiss-error" class="underline font-bold mt-3">إخفاء الرسالة</button></div>
 <section id="upload-section" class="bg-white rounded-2xl p-5 md:p-8 card-shadow">
  <div id="drop-zone" class="upload-zone rounded-xl p-8 md:p-10 cursor-pointer flex flex-col items-center justify-center min-h-64 text-center">
   <div class="text-5xl text-brand-600 mb-4">⇧</div><h3 class="text-xl font-bold mb-2">اختر فيديو للبدء</h3><p class="text-gray-500 text-sm mb-5">MP4 أو WebM أو MOV — يُفضّل البدء بفيديو قصير</p><button type="button" id="choose-file" class="bg-brand-600 hover:bg-brand-700 text-white font-bold py-3 px-7 rounded-full">اختيار فيديو من الجهاز</button>
   <input type="file" id="file-input" accept="video/*,.mov,.m4v" class="hidden">
  </div>
  <p class="text-xs text-gray-500 mt-4">ملاحظة: يجب فتح الصفحة عبر HTTPS مع اتصال إنترنت لتحميل مكتبات المعالجة أول مرة.</p>
 </section>
 <section id="workspace" class="hidden space-y-5">
  <div id="memory-warning" class="hidden bg-orange-50 border-r-4 border-orange-500 text-orange-900 p-4 rounded-xl text-sm">⚠️ هذا الملف أو إعداد الدقة قد يستهلك ذاكرة كبيرة. على الهاتف، جرّب فيديو قصيراً ودقة 720p أولاً.</div>
  <div class="bg-white rounded-2xl p-5 card-shadow grid md:grid-cols-3 gap-5 items-center">
   <video id="original-preview" class="w-full bg-black rounded-xl aspect-video object-contain md:col-span-1" controls playsinline></video>
   <div class="md:col-span-2 min-w-0"><h3 id="file-name" class="font-bold text-lg break-all mb-3"></h3><div class="grid grid-cols-2 gap-3 text-sm"><div class="bg-gray-50 border rounded-lg p-3"><b>الحجم</b><div id="file-size">—</div></div><div class="bg-gray-50 border rounded-lg p-3"><b>المدة</b><div id="file-duration">—</div></div><div class="bg-gray-50 border rounded-lg p-3"><b>الأبعاد</b><div id="file-resolution">—</div></div><div class="bg-gray-50 border rounded-lg p-3"><b>الصيغة</b><div id="file-type">—</div></div></div><button id="replace-file" class="mt-4 text-red-600 font-bold text-sm">حذف واستبدال الفيديو</button></div>
  </div>
  <div class="grid md:grid-cols-2 gap-5">
   <div class="bg-white rounded-2xl p-5 card-shadow"><h3 class="font-bold text-lg border-b pb-3 mb-4">أبعاد الفيديو</h3><div id="ratio-options" class="grid grid-cols-2 gap-3"></div><p class="text-xs text-gray-500 mt-3">الأبعاد غير الأصلية قد تضيف حوافاً سوداء للحفاظ على الصورة دون قص أو تشويه.</p></div>
   <div class="bg-white rounded-2xl p-5 card-shadow"><h3 class="font-bold text-lg border-b pb-3 mb-4">الدقة والتحسين</h3><label for="resolution" class="block text-sm font-bold mb-2">دقة الإخراج (الارتفاع)</label><select id="resolution" class="w-full p-3 border rounded-lg"><option value="480">480p — اقتصادي</option><option value="720" selected>720p — مناسب للهاتف</option><option value="1080">1080p — Full HD</option><option value="1440">1440p — QHD</option><option value="2160">2160p — 4K (ثقيل جداً)</option></select>
    <label class="flex items-center gap-3 mt-4"><input type="checkbox" id="sharpen" checked class="w-5 h-5"><span class="text-sm">زيادة الحدة (Sharpen)</span></label><label class="flex items-center gap-3 mt-3"><input type="checkbox" id="denoise" class="w-5 h-5"><span class="text-sm">تقليل الضوضاء (Denoise — أبطأ)</span></label>
    <div class="mt-4 border-t pt-4"><div class="text-sm font-bold mb-2">سرعة المعالجة</div><div class="grid grid-cols-2 gap-3"><label><input type="radio" name="preset" value="fast" checked class="hidden"><div class="border rounded-lg p-3 text-center text-sm cursor-pointer">أسرع</div></label><label><input type="radio" name="preset" value="quality" class="hidden"><div class="border rounded-lg p-3 text-center text-sm cursor-pointer">جودة أعلى</div></label></div></div>
   </div>
  </div>
  <div class="text-center"><button id="start-btn" class="bg-brand-600 hover:bg-brand-700 text-white font-bold py-4 px-10 rounded-full shadow-lg w-full sm:w-auto">بدء المعالجة</button></div>
 </section>
 <section id="progress-section" class="hidden mt-5 bg-white rounded-2xl p-6 card-shadow text-center"><h3 id="progress-status" class="text-xl font-bold mb-3">تهيئة المحرك…</h3><div class="h-4 bg-gray-200 rounded-full overflow-hidden"><div id="progress-bar" class="h-full bg-brand-500 rounded-full" style="width:0%"></div></div><div class="flex justify-between text-sm font-bold mt-3"><span id="progress-percent">0%</span><span id="elapsed">الوقت: 00:00</span></div><p class="text-xs text-gray-500 mt-4">لا تغلق الصفحة أو تقفل الشاشة أثناء المعالجة.</p><button id="cancel-btn" class="mt-4 border-2 border-red-500 text-red-600 font-bold py-2 px-8 rounded-full">إلغاء المعالجة</button></section>
 <section id="result-section" class="hidden mt-5 bg-white rounded-2xl p-5 md:p-8 card-shadow"><div class="text-center mb-6"><h2 class="text-2xl font-extrabold text-green-700">اكتملت المعالجة</h2><p class="text-gray-600 text-sm mt-2">راجع الفيديو قبل تنزيله. تغيير الدقة لا يضمن استعادة التفاصيل المفقودة.</p></div><div class="grid md:grid-cols-2 gap-5"><div><div class="font-bold mb-2">الفيديو الأصلي <span id="old-size" class="text-xs text-gray-500"></span></div><video id="result-original" class="w-full bg-black rounded-xl aspect-video" controls playsinline></video></div><div><div class="font-bold mb-2">الفيديو الناتج <span id="new-size" class="text-xs text-gray-500"></span></div><video id="result-video" class="w-full bg-black rounded-xl aspect-video" controls playsinline></video></div></div><div class="flex flex-col sm:flex-row gap-3 justify-center mt-7"><button id="download-btn" class="bg-brand-600 hover:bg-brand-700 text-white font-bold py-3 px-8 rounded-full">تنزيل الفيديو المعالج</button><button id="again-btn" class="bg-gray-100 border font-bold py-3 px-8 rounded-full">معالجة فيديو آخر</button></div></section>
</main>
<footer class="bg-gray-800 text-gray-300 text-center text-xs p-5 mt-8">جنكيز — يستخدم FFmpeg/WebAssembly. المعالجة محلية داخل المتصفح؛ تنزيل المحرك يحتاج إلى الإنترنت.</footer>
<script>
(() => {
'use strict';
const $ = id => document.getElementById(id);
const ui = {upload:$('upload-section'),workspace:$('workspace'),progress:$('progress-section'),result:$('result-section'),error:$('error-box'),errorText:$('error-text'),file:$('file-input'),start:$('start-btn')};
let engine=null, file=null, originalURL=null, outputURL=null, busy=false, timer=null, startedAt=0, outputName='jnkyz-enhanced.mp4', runToken=0;
const ratios=[{label:'الأبعاد الأصلية',desc:'بدون تغيير النسبة',value:'original',checked:true},{label:'تيك توك / شورتس',desc:'عمودي 9:16',value:'9/16'},{label:'مربع',desc:'1:1',value:'1/1'},{label:'إنستغرام عمودي',desc:'4:5',value:'4/5'},{label:'يوتيوب',desc:'أفقي 16:9',value:'16/9'}];
$('ratio-options').innerHTML=ratios.map((r,i)=>`<label class="cursor-pointer"><input type="radio" name="ratio" value="${r.value}" class="hidden" ${r.checked?'checked':''}><div class="h-full border rounded-lg p-3 text-center"><b class="block text-sm">${r.label}</b><span class="text-xs text-gray-500">${r.desc}</span></div></label>`).join('');
function showError(message){ui.errorText.textContent=message;ui.error.classList.remove('hidden');}
function hideError(){ui.error.classList.add('hidden');}
function timeFmt(sec){if(!Number.isFinite(sec)||sec<0)return'0:00';const m=Math.floor(sec/60),s=Math.floor(sec%60);return `${m}:${String(s).padStart(2,'0')}`;}
function setProgress(message,pct){$('progress-status').textContent=message;$('progress-percent').textContent=Math.round(pct)+'%';$('progress-bar').style.width=Math.max(0,Math.min(100,pct))+'%';}
function checkMemory(){const heavy=file&&(file.size>60*1024*1024||$('resolution').value==='2160');$('memory-warning').classList.toggle('hidden',!heavy);}
function releaseURL(url){if(url)URL.revokeObjectURL(url);}
function selectFile(f){if(busy)return;if(!f)return;if(!f.type.startsWith('video/')&&!/\.(mp4|mov|m4v|webm|mkv|avi)$/i.test(f.name)){showError('الملف المختار لا يبدو ملف فيديو صالحاً.');return;}file=f;hideError();releaseURL(originalURL);originalURL=URL.createObjectURL(f);$('original-preview').src=originalURL;$('file-name').textContent=f.name;$('file-size').textContent=(f.size/1048576).toFixed(2)+' MB';$('file-type').textContent=(f.name.split('.').pop()||'VIDEO').toUpperCase();$('file-duration').textContent='جارٍ القراءة…';$('file-resolution').textContent='جارٍ القراءة…';$('original-preview').onloadedmetadata=()=>{$('file-resolution').textContent=`${$('original-preview').videoWidth} × ${$('original-preview').videoHeight}`;$('file-duration').textContent=timeFmt($('original-preview').duration);ui.upload.classList.add('hidden');ui.workspace.classList.remove('hidden');checkMemory();};$('original-preview').onerror=()=>{ui.upload.classList.add('hidden');ui.workspace.classList.remove('hidden');$('file-resolution').textContent='غير متاح';$('file-duration').textContent='غير متاح';checkMemory();};$('original-preview').load();}
$('choose-file').onclick=()=> $('file-input').click();$('drop-zone').onclick=e=>{if(e.target.id!=='choose-file')$('file-input').click();};$('file-input').onchange=e=>{selectFile(e.target.files[0]);e.target.value='';};
const dz=$('drop-zone');['dragenter','dragover'].forEach(ev=>dz.addEventListener(ev,e=>{e.preventDefault();dz.classList.add('dragover');}));['dragleave','drop'].forEach(ev=>dz.addEventListener(ev,e=>{e.preventDefault();dz.classList.remove('dragover');}));dz.addEventListener('drop',e=>selectFile(e.dataTransfer.files[0]));
$('resolution').onchange=checkMemory;$('dismiss-error').onclick=hideError;
async function loadScriptAny(urls, globalName){if(window[globalName])return window[globalName];let lastError;for(const url of urls){try{await new Promise((resolve,reject)=>{const script=document.createElement('script');script.src=url;script.async=true;script.onload=()=>resolve();script.onerror=()=>{script.remove();reject(new Error('تعذر تحميل '+url));};document.head.appendChild(script);});if(window[globalName])return window[globalName];lastError=new Error('تم تحميل الملف لكن لم تظهر المكتبة '+globalName);}catch(e){lastError=e;console.warn('[FFmpeg CDN fallback]',e);}}throw lastError||new Error('تعذر تحميل '+globalName);}
async function blobURLAny(urls,mime,toBlobURL){let lastError;for(const url of urls){try{return await toBlobURL(url,mime);}catch(e){lastError=e;console.warn('[FFmpeg core fallback]',url,e);}}throw lastError||new Error('تعذر تحميل ملفات محرك FFmpeg');}
async function initEngine(){if(engine&&engine.loaded)return engine;setProgress('جاري تحميل مكتبات المعالجة…',2);const ffmpegGlobal=await loadScriptAny(['https://cdn.jsdelivr.net/npm/@ffmpeg/ffmpeg@0.12.7/dist/umd/ffmpeg.js','https://unpkg.com/@ffmpeg/ffmpeg@0.12.7/dist/umd/ffmpeg.js'], 'FFmpeg');const utilGlobal=await loadScriptAny(['https://cdn.jsdelivr.net/npm/@ffmpeg/util@0.12.1/dist/umd/index.js','https://unpkg.com/@ffmpeg/util@0.12.1/dist/umd/index.js'], 'FFmpegUtil');const {FFmpeg}=ffmpegGlobal;const {toBlobURL}=utilGlobal;if(typeof FFmpeg!=='function'||typeof toBlobURL!=='function')throw new Error('تم تنزيل المكتبات لكن إصدارها غير متوافق. أعد نشر ملف index.html المحدّث.');engine=new FFmpeg();engine.on('log',({message})=>console.log('[FFmpeg]',message));engine.on('progress',({progress})=>{if(Number.isFinite(progress))setProgress('جاري ترميز الفيديو…',15+Math.min(1,Math.max(0,progress))*80);});setProgress('جاري تحميل محرك المعالجة…',5);const bases=['https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.6/dist/umd','https://unpkg.com/@ffmpeg/core@0.12.6/dist/umd'];const coreURL=await blobURLAny(bases.map(b=>b+'/ffmpeg-core.js'),'text/javascript',toBlobURL);const wasmURL=await blobURLAny(bases.map(b=>b+'/ffmpeg-core.wasm'),'application/wasm',toBlobURL);try{await engine.load({coreURL,wasmURL});}catch(e){engine=null;throw new Error('تم تنزيل المكتبات لكن تعذر تشغيل محرك الفيديو. افتح التطبيق من رابط GitHub Pages يبدأ بـ https:// وليس من معاينة GitHub أو ملف محلي. التفاصيل: '+(e.message||e));}return engine;}
function buildArgs(input,output){const h=Number($('resolution').value),ratio=document.querySelector('input[name="ratio"]:checked').value,filters=[];if(ratio==='original'){filters.push(`scale=-2:${h}`);}else{const [rw,rh]=ratio.split('/').map(Number);const w=Math.round((h*rw/rh)/2)*2;filters.push(`scale=${w}:${h}:force_original_aspect_ratio=decrease`);filters.push(`pad=${w}:${h}:(ow-iw)/2:(oh-ih)/2`);filters.push('setsar=1');}if($('denoise').checked)filters.push('hqdn3d=1.5:1.5:6:6');if($('sharpen').checked)filters.push('unsharp=5:5:0.7:5:5:0');const quality=document.querySelector('input[name="preset"]:checked').value;return ['-i',input,'-map','0:v:0','-map','0:a:0?','-vf',filters.join(','),'-c:v','libx264','-preset',quality==='fast'?'ultrafast':'fast','-crf',quality==='fast'?'28':'23','-pix_fmt','yuv420p','-c:a','aac','-b:a','128k','-movflags','+faststart','-y',output];}
async function processVideo(){if(!file||busy)return;busy=true;const token=++runToken;ui.start.disabled=true;ui.workspace.classList.add('hidden');ui.result.classList.add('hidden');ui.progress.classList.remove('hidden');hideError();startedAt=Date.now();timer=setInterval(()=>$('elapsed').textContent='الوقت: '+timeFmt((Date.now()-startedAt)/1000),1000);let inputName='input-video'+((file.name.match(/\.[a-z0-9]+$/i)||[])[0]||'.mp4'),out='output-video.mp4';try{const ff=await initEngine();if(token!==runToken)return;setProgress('جاري تجهيز الفيديو…',12);await ff.writeFile(inputName,await window.FFmpegUtil.fetchFile(file));if(token!==runToken)return;setProgress('بدأت المعالجة…',15);const code=await ff.exec(buildArgs(inputName,out));if(token!==runToken)return;if(code!==0)throw new Error('فشل FFmpeg في معالجة الفيديو. جرّب فيديو أقصر أو دقة 480p/720p.');setProgress('جاري تجهيز الملف للتنزيل…',98);const data=await ff.readFile(out);const blob=new Blob([data],{type:'video/mp4'});releaseURL(outputURL);outputURL=URL.createObjectURL(blob);outputName='jnkyz-video-'+$('resolution').value+'p.mp4';$('result-original').src=originalURL;$('result-video').src=outputURL;$('old-size').textContent='('+ (file.size/1048576).toFixed(2)+' MB)';$('new-size').textContent='('+ (blob.size/1048576).toFixed(2)+' MB)';ui.progress.classList.add('hidden');ui.result.classList.remove('hidden');setProgress('اكتملت المعالجة',100);}catch(err){console.error(err);if(token===runToken){if(err&&err.name==='AbortError')showError('تم إيقاف المعالجة.');else showError((err&&err.message?err.message:String(err))+' — افتح رابط GitHub Pages المنشور مباشرة في Chrome، ثم حدّث الصفحة تحديثاً كاملاً.');ui.progress.classList.add('hidden');ui.workspace.classList.remove('hidden');}}finally{clearInterval(timer);busy=false;ui.start.disabled=false;if(engine&&engine.loaded){try{await engine.deleteFile(inputName);}catch(e){}try{await engine.deleteFile(out);}catch(e){}}}}
$('start-btn').onclick=processVideo;
$('cancel-btn').onclick=async()=>{if(!busy)return;runToken++;clearInterval(timer);if(engine){try{engine.terminate();}catch(e){}engine=null;}busy=false;ui.start.disabled=false;ui.progress.classList.add('hidden');ui.workspace.classList.remove('hidden');showError('أُلغيت العملية. يمكنك المحاولة مرة أخرى.');};
function reset(){if(busy){$('cancel-btn').click();}releaseURL(originalURL);releaseURL(outputURL);originalURL=null;outputURL=null;file=null;$('original-preview').removeAttribute('src');$('result-original').removeAttribute('src');$('result-video').removeAttribute('src');$('original-preview').load();$('result-original').load();$('result-video').load();ui.workspace.classList.add('hidden');ui.progress.classList.add('hidden');ui.result.classList.add('hidden');ui.upload.classList.remove('hidden');hideError();}
$('replace-file').onclick=reset;$('again-btn').onclick=reset;$('download-btn').onclick=()=>{if(!outputURL)return;const a=document.createElement('a');a.href=outputURL;a.download=outputName;document.body.appendChild(a);a.click();a.remove();};
})();
</script>
</body>
</html>
